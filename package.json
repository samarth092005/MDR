{
  "name": "mdr-btp",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9.9.1",
    "@cap-js/hana": "^2",
    "@sap/xssec": "^3",
    "axios": "^1.16.1",
    "express": "^4",
    "hdb": "^2.27.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^7",
    "@sap/eslint-plugin-cds": "^3",
    "cds-plugin-ui5": "^0.13.0",
    "eslint": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build": "cds build --production",
    "watch-zmdr_bulkload": "cds watch --open com.intapptics.zmdrbulkload/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "odata": {
      "version": "v4"
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked"
        },
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa",
          "vcap": {
            "label": "xsuaa"
          }
        },
				"db": {
					"kind": "hana",
          "vcap": {
          "label": "hana"
        }
				}
			},
      "destinations": {
        "kind": "destination",
        "vcap": {
          "label": "destination"
        }
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  },
  "workspaces": [
    "app/*"
  ]
}
