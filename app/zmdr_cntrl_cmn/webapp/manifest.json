{
  "_version": "1.53.0",
  "sap.app": {
    "id": "com.intapptics.zmdrcntrlcmn",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.16.5",
      "toolsId": "98288bcf-81c3-4a40-b56c-7036be8d728a"
    },
    "crossNavigation": {
      "inbounds": {
        "zmdr_central_cmn-manage": {
          "semanticObject": "zmdr_central_cmn",
          "action": "manage",
          "title": "Central Common",
          "subTitle": "Common Application - Do not launch directly",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "mdrapi/central/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "ZMDGCPCNTRLVAL01_CDS": {
        "uri": "mdrapi/central/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZMDGCPCNTRLVAL01_CDS/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "ZMDR_UTILITY_WORKFLOW_SRV": {
        "uri": "mdrapi/workflow/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZMDR_UTILITY_WORKFLOW_SRV/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "ZMDGCPCNTRLURL01_CDS": {
        "uri": "mdrapi/central/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/ZMDGCPCNTRLURL01_CDS/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.20",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.intapptics.zmdrcntrlcmn.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "autoExpandSelect": true,
          "operationMode": "Server",
          "synchronizationMode": "None",
          "groupId": "$direct"
        }
      },
      "ZMDGCPCNTRLVAL01_CDS": {
        "dataSource": "ZMDGCPCNTRLVAL01_CDS",
        "preload": true,
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "autoExpandSelect": true,
          "operationMode": "Server",
          "synchronizationMode": "None",
          "groupId": "$direct"
        }
      },
      "ZMDR_UTILITY_WORKFLOW_SRV": {
        "dataSource": "ZMDR_UTILITY_WORKFLOW_SRV",
        "preload": true,
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "autoExpandSelect": true,
          "operationMode": "Server",
          "synchronizationMode": "None"
        }
      },
      "ZMDGCPCNTRLURL01_CDS": {
        "dataSource": "ZMDGCPCNTRLURL01_CDS",
        "preload": true,
        "type": "sap.ui.model.odata.v4.ODataModel",
        "settings": {
          "autoExpandSelect": true,
          "operationMode": "Server",
          "synchronizationMode": "None"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.intapptics.zmdrcntrlcmn.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "id": "mainscreen-default",
          "pattern": "detail/{SAPOrigin}/{AppTaskId}/{query}",
          "name": "detail",
          "target": [
            "mainscreen"
          ]
        },
        {
          "id": "mainscreen",
          "pattern": "/:?sap-iapp-state:",
          "name": "mainscreen",
          "target": [
            "mainscreen"
          ]
        }
      ],
      "targets": {
        "mainscreen": {
          "viewLevel": 1,
          "viewId": "mainScreen",
          "viewName": "MainScreen"
        },
        "notFound": {
          "viewLevel": 1,
          "viewId": "notFound",
          "viewName": "notFound"
        }
      }
    },
    "rootView": {
      "viewName": "com.intapptics.zmdrcntrlcmn.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "mdr.cap.btp"
  },
  "sap.bpa.task": {
    "_version": "1.0.0",
    "outcomes": [
      {
        "id": "approve",
        "label": "Approve"
      },
      {
        "id": "reject",
        "label": "Reject"
      }
    ],
    "inputs": {
      "$schema": "http://json-schema.org/draft-07/schema",
      "title": "input",
      "type": "object",
      "required": [
        "workflowId",
        "entityName",
        "tablename",
        "operationType",
        "requestorId",
        "totalSteps"
      ],
      "properties": {
        "workflowId": {
          "type": "string",
          "title": "Workflow ID",
          "description": "Workflow ID"
        },
        "entityName": {
          "type": "string",
          "title": "Entity Name",
          "description": "Entity Name"
        },
        "tablename": {
          "type": "string",
          "title": "Table Name",
          "description": "Table Name"
        },
        "operationType": {
          "type": "string",
          "title": "Operation Type",
          "description": "Operation Type"
        },
        "requestorId": {
          "type": "string",
          "title": "Requestor ID",
          "description": "Requestor ID"
        },
        "totalSteps": {
          "type": "number",
          "title": "Total Steps",
          "description": "Total Steps"
        }
      }
    },
    "outputs": {
      "$schema": "http://json-schema.org/draft-07/schema",
      "title": "output",
      "type": "object",
      "required": [
        "comment"
      ],
      "properties": {
        "comment": {
          "type": "string",
          "title": "Comment",
          "description": "Approver Comment"
        }
      }
    },
    "category": "approval"
  }
}